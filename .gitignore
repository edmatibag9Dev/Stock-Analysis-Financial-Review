# Office lock files
.~lock.*#

# Python cache
__pycache__/
*.pyc
*.pyo

# OS files
.DS_Store
Thumbs.db

# Secrets and local-only config (personal identifiers stay out of committed docs)
.env
.env.*
!.env.example
CONFIG.local.md

# Backups and environments
*.bak*
.venv/
node_modules/

# Temp / local outputs
outputs/
*.log

# --- Ticker analyses: Drive-first, repo = active working set only ---
# Google Drive is the system of record (every analysis). The repo holds only
# tickers Ed is actively engaged with (open position / active options / live
# watchlist). Ignore all $-prefixed ticker folders by default so Drive-only
# passes (e.g. $NUAI) can never be committed by accident.
/$*/
# To ADD an approved ticker to the repo, force-add it once — it stays tracked:
#   git add -f "$TICKER/" ':(exclude)**/*_sentiment_raw_*.json'
# (Legacy non-$ folders BROS/PLTR/SG/FSLY/TRMB are already tracked and migrate
#  to $TICKER on next touch.)

# Local scratch: stale git/Office lock files swept aside for manual deletion
_to_delete/

# Stocktwits captures stay local even inside force-added ticker folders (skill Phase 1H, decision D4)
**/$*_sentiment_raw_*.json

# Paid-subscriber transcripts (e.g. Substack) and their capture scratch stay local — public repo, not ours to republish
Transcripts/
_work/
